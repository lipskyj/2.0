{
  "name": "ChatSession",
  "type": "object",
  "properties": {
    "step": {
      "type": "number",
      "default": 1,
      "description": "\u05d4\u05e9\u05dc\u05d1 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9 \u05d1\u05ea\u05d4\u05dc\u05d9\u05da"
    },
    "family_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e6\u05d5\u05d5\u05ea"
    },
    "family_location": {
      "type": "string",
      "description": "\u05d1\u05d9\u05ea \u05e1\u05e4\u05e8 / \u05d0\u05e8\u05d2\u05d5\u05df"
    },
    "family_info": {
      "type": "string",
      "description": "\u05e8\u05e7\u05e2 \u05d7\u05d9\u05e0\u05d5\u05db\u05d9"
    },
    "educational_challenge": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05d0\u05ea\u05d2\u05e8 \u05d4\u05d7\u05d9\u05e0\u05d5\u05db\u05d9"
    },
    "target_audience": {
      "type": "string",
      "description": "\u05e7\u05d4\u05dc \u05d4\u05d9\u05e2\u05d3 \u05e9\u05dc \u05d4\u05e4\u05ea\u05e8\u05d5\u05df"
    },
    "pain_point_users": {
      "type": "string",
      "description": "\u05dc\u05de\u05d9 \u05db\u05d5\u05d0\u05d1? (\u05de\u05d5\u05e8\u05d4, \u05ea\u05dc\u05de\u05d9\u05d3, \u05d4\u05d5\u05e8\u05d4)"
    },
    "problem_causes": {
      "type": "string",
      "description": "\u05d4\u05d2\u05d5\u05e8\u05de\u05d9\u05dd \u05dc\u05d1\u05e2\u05d9\u05d4"
    },
    "problem_symptoms": {
      "type": "string",
      "description": "\u05e1\u05d9\u05de\u05e4\u05d8\u05d5\u05de\u05d9\u05dd (\u05d0\u05d9\u05da \u05d4\u05d1\u05e2\u05d9\u05d4 \u05e0\u05e8\u05d0\u05d9\u05ea \u05d1\u05e9\u05d8\u05d7)"
    },
    "assumptions": {
      "type": "string",
      "description": "\u05d4\u05e0\u05d7\u05d5\u05ea \u05d9\u05e1\u05d5\u05d3"
    },
    "pedagogical_framework": {
      "type": "string",
      "description": "\u05d4\u05de\u05e1\u05d2\u05e8\u05ea \u05d4\u05e4\u05d3\u05d2\u05d5\u05d2\u05d9\u05ea \u05e9\u05e0\u05d1\u05d7\u05e8\u05d4"
    },
    "activity_idea": {
      "type": "string",
      "description": "\u05d4\u05e8\u05e2\u05d9\u05d5\u05df \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9 \u05dc\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d0\u05d5 \u05de\u05e9\u05d7\u05e7"
    },
    "ai_suggestion": {
      "type": "string",
      "description": "\u05d4\u05e6\u05e2\u05ea AI \u05dc\u05e0\u05d9\u05e1\u05d5\u05d7 \u05d4\u05d1\u05e2\u05d9\u05d4 \u05d5\u05d4\u05e4\u05ea\u05e8\u05d5\u05df"
    },
    "agreed_solution": {
      "type": "string",
      "description": "\u05d4\u05e4\u05ea\u05e8\u05d5\u05df \u05d4\u05de\u05d5\u05e1\u05db\u05dd \u05dc\u05d0\u05d7\u05e8 \u05d4\u05e6\u05e2\u05ea \u05d4-AI"
    },
    "activity_description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05de\u05e4\u05d5\u05e8\u05d8 \u05e9\u05dc \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea"
    },
    "final_prompt": {
      "type": "string",
      "description": "\u05d4\u05e4\u05e8\u05d5\u05de\u05e4\u05d8 \u05d4\u05e1\u05d5\u05e4\u05d9 \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4"
    },
    "is_complete": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05ea\u05d4\u05dc\u05d9\u05da \u05d4\u05d5\u05e9\u05dc\u05dd"
    },
    "user_email": {
      "type": "string",
      "description": "\u05d4\u05de\u05d9\u05d3\u05e2 \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d9\u05e6\u05e8 \u05d0\u05ea \u05d4\u05e1\u05e9\u05df"
    }
  },
  "required": []
}